--========================================================--
-- BACKUP ROOM CHECK
--========================================================--

task.spawn(function()

	while task.wait(0.5) do

		if hasSpawnedOnce then
			continue
		end

		local newest = highestRoom
		local newestRoom = nil

		for _, room in ipairs(
			CurrentRooms:GetChildren()
		) do

			local number =
				GetRoomNumber(room)

			if number and number > newest then

				newest = number
				newestRoom = room

			end

		end

		if newestRoom then
			NewRoom(newestRoom)
		end

	end

end)

