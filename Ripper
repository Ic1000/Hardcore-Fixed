--========================================================--
-- ROOM NUMBER
--========================================================--

local CurrentRooms =
	workspace:WaitForChild("CurrentRooms")

local highestRoom = -1

local function GetRoomNumber(room)

	if not room then
		return nil
	end

	local attribute =
		room:GetAttribute("RoomNumber")

	if typeof(attribute) == "number" then
		return attribute
	end

	return tonumber(room.Name)

end

--========================================================--
-- INITIAL ROOM
--========================================================--

for _, room in ipairs(CurrentRooms:GetChildren()) do

	local number =
		GetRoomNumber(room)

	if number and number > highestRoom then
		highestRoom = number
	end

end

print(
	"[RIPPER] Current room:",
	highestRoom
)

--========================================================--
-- FIRST NEW ROOM ONLY
--========================================================--

local function NewRoom(room)

	local roomNumber =
		GetRoomNumber(room)

	if not roomNumber then
		return
	end

	if roomNumber <= highestRoom then
		return
	end

	highestRoom = roomNumber

	print(
		"[RIPPER] New room:",
		roomNumber
	)

	if hasSpawnedOnce then
		print("[RIPPER] Already spawned once - ignored")
		return
	end

	local char =
		LocalPlayer.Character

	local hum =
		char and
		char:FindFirstChildOfClass("Humanoid")

	if not hum or hum.Health <= 0 then
		return
	end

	print("[RIPPER] FIRST NEW ROOM - SPAWNING")

	task.spawn(function()
		SpawnRipper()
	end)

end

