-- ====== HÀM SPAWN QUÁI CUSTOM CHUNG ======
local function SafeSpawnEntity(entityName, cooldown, allowDuringFigure)
	cooldown = cooldown or 10

	if _G.SeekActive or _G.FigureActive or tick() < SeekCooldownTimer or latestRoom.Value == 50 or latestRoom.Value == 100 then 
		return 
	end

	if entityName == "Rebound" then
		if _G.ActiveEntities["Rebound"] == true or Workspace:FindFirstChild("Rebound") then
			return
		end
	end

	if _G.ActiveEntities[entityName] == true then return end
	if _G.GlobalCooldown then return end

	_G.ActiveEntities[entityName] = true
	_G.GlobalCooldown = true
	
	RecordEntityEncounter(entityName)

	local success, err = pcall(function()
		local scriptContent = CachedEntityScripts[entityName] or game:HttpGet(EntityScripts[entityName])
		local loadedScript = loadstring(scriptContent)
		if loadedScript then
			loadedScript()
		else
			error("Không thể kích hoạt script")
		end
	end)

	if not success then
		_G.ActiveEntities[entityName] = false
		_G.GlobalCooldown = false
		Notify("Lỗi Spawn Quái: " .. entityName, true)
		warn("[Entity Error] Lỗi tải quái " .. entityName .. ": " .. tostring(err))
		return
	end

	task.delay(cooldown, function()
		_G.GlobalCooldown = false
	end)

	task.spawn(function()
		task.wait(3)
		local entityModel = Workspace:FindFirstChild(entityName)
		if entityModel then
			repeat 
				task.wait(0.5) 
			until not entityModel:IsDescendantOf(Workspace)
		else
			task.wait(20)
		end
		_G.ActiveEntities[entityName] = false
	end)
end

