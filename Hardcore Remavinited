-- ====== HỆ THỐNG KIỂM TRA SEEK & FIGURE ======
local function CheckBossStatus()
	local currentRoomVal = latestRoom.Value
	
	local seekPresent = Workspace:FindFirstChild("SeekMoving") or 
	                    Workspace:FindFirstChild("SeekMovingNew") or 
	                    Workspace:FindFirstChild("SeekMovingNewClone") or 
	                    Workspace:FindFirstChild("Seek") ~= nil

	local figurePresent = Workspace:FindFirstChild("Figure") ~= nil or 
	                      Workspace:FindFirstChild("FigureRig") ~= nil or 
	                      Workspace:FindFirstChild("FigureSetup") ~= nil or
	                      currentRoomVal == 50 or currentRoomVal == 100

	local currentRooms = Workspace:FindFirstChild("CurrentRooms")
	if currentRooms then
		local room = currentRooms:FindFirstChild(tostring(currentRoomVal))
		if room then
			local roomName = room.Name:lower()
			if room:FindFirstChild("SeekFolder") or room:FindFirstChild("SeekTrigger") or room:GetAttribute("Seek") or roomName:find("seek") then
				seekPresent = true
			end
			if room:FindFirstChild("Figure") or roomName:find("figure") then
				figurePresent = true
			end
		end
	end

	if LastSeekState and not seekPresent then
		SeekCooldownTimer = tick() + 12 
	end
	LastSeekState = seekPresent

	_G.SeekActive = seekPresent
	_G.FigureActive = figurePresent
	_G.BossActive = (seekPresent or figurePresent)

	return _G.BossActive
end

task.spawn(function()
	while task.wait(0.3) do
		CheckBossStatus()
	end
end)

