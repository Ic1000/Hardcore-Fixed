local function HasCrucifixInInventory()
	local char = LocalPlayer.Character
	if char then
		for _, v in ipairs(char:GetChildren()) do
			if v:IsA("Tool") and (string.find(v.Name:lower(), "crucifix") or string.find(v.Name:lower(), "thánh giá")) then
				return true
			end
		end
	end
	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, v in ipairs(backpack:GetChildren()) do
			if v:IsA("Tool") and (string.find(v.Name:lower(), "crucifix") or string.find(v.Name:lower(), "thánh giá")) then
				return true
			end
		end
	end
	return false
end

local function CheckRoomForCrucifixSpawn(room)
	if HasCrucifixInInventory() then return end

	local assets = room:FindFirstChild("Assets") or room
	local hasValidFurniture = false
	
	local validKeywords = {"drawer", "chest", "table", "desk", "bed"}
	for _, desc in ipairs(assets:GetDescendants()) do
		if desc:IsA("Model") or desc:IsA("BasePart") then
			local lowerName = string.lower(desc.Name)
			for _, kw in ipairs(validKeywords) do
				if string.find(lowerName, kw) then
					hasValidFurniture = true
					break
				end
			end
		end
		if hasValidFurniture then break end
	end

	if not hasValidFurniture then return end

	if math.random(1, 75) <= 1 then
		pcall(function()
			loadstring(game:HttpGet('https://raw.githubusercontent.com/PenguinManiack/Crucifix/main/Crucifix.lua'))()
			Notify("Bạn đã tìm thấy Thánh Giá!", true)
		end)
	end
end

