-- Map Tracking Logic (Các phòng đằng sau)
local rooms = Workspace.CurrentRooms
local value = ReplicatedStorage.GameData.LatestRoom.Value

local nextroom = rooms:FindFirstChild(value + 1)
local room = rooms:FindFirstChild(value)
local room1 = rooms:FindFirstChild(value - 1)
local room2 = rooms:FindFirstChild(value - 2)
local room3 = rooms:FindFirstChild(value - 3)
local room4 = rooms:FindFirstChild(value - 4)
local room5 = rooms:FindFirstChild(value - 5)

ReplicatedStorage.GameData.LatestRoom.Changed:Connect(function()
    value = ReplicatedStorage.GameData.LatestRoom.Value
    nextroom = rooms:FindFirstChild(value + 1)
    room = rooms:FindFirstChild(value)
    room1 = rooms:FindFirstChild(value - 1)
    room2 = rooms:FindFirstChild(value - 2)
    room3 = rooms:FindFirstChild(value - 3)
    room4 = rooms:FindFirstChild(value - 4)
    room5 = rooms:FindFirstChild(value - 5)
end)

-- ========================================================
--         PHẦN SỬA LỖI: CHẶN XUNG ĐỘT DI CHUYỂN & DESTROY
-- ========================================================

local isChasing = false -- Biến cờ kiểm tra xem quái có đang rượt người chơi hay không

-- Tracking Line of Sight & Following
task.spawn(function()
    while task.wait(0.3) do
        if huh or hit or isDeactivated then break end
        if character:GetAttribute("Hiding") then continue end
        
        local hitbox = 60 -- Tầm nhìn để quái phát hiện ra bạn
        local origin = ambush.Position
        local direction = (HumanoidRootPart.Position - origin).Unit
        local ray = Ray.new(origin, direction * hitbox)
        local raycast = Workspace:Raycast(ray.Origin, ray.Direction)
        
        if raycast and raycast.Instance.Parent == character then
            found = true
            isChasing = true -- Đánh dấu là đang rượt người chơi -> Dừng việc chạy theo phòng lại!
            
            -- Hủy tween di chuyển cũ của phòng (nếu có) để mượt hơn
            pcall(function() TweenService:Cancel(ambush) end)
            
            task.spawn(function()
                while task.wait() do
                    if hit or isDeactivated then break end
                    -- Quái sẽ liên tục lao thẳng theo vị trí của bạn với tốc độ mượt
                    local follow = TweenService:Create(ambush, TweenInfo.new(0.8, Enum.EasingStyle.Linear), {CFrame = HumanoidRootPart.CFrame})
                    follow:Play()
                end
            end)
            break -- Thoát vòng quét tầm nhìn vì đã bắt đầu rượt đuổi
        end
    end
end)

-- Set CFrame khởi tạo ở phòng đằng sau (room5)
if room5 then
    ambush.CFrame = room5.RoomEntrance.CFrame
elseif room and room:FindFirstChild("RoomEntrance") then
    ambush.CFrame = room.RoomEntrance.CFrame * CFrame.new(0, 0, 50)
end

-- Di chuyển Deer God xuyên qua các phòng phía sau (Có kiểm tra cờ isChasing)
task.spawn(function()
    local function moveToRoom(targetRoom)
        -- Nếu quái đã chết, đã vô hiệu hóa, hoặc đang rượt người chơi thì huỷ lịch trình chạy phòng
        if hit or isDeactivated or isChasing then return end 
        if targetRoom and targetRoom:FindFirstChild("RoomEntrance") then
            local tween = TweenService:Create(ambush, TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {CFrame = targetRoom.RoomEntrance.CFrame})
            tween:Play()
            tween.Completed:Wait()
        end
    end

    moveToRoom(room4)
    moveToRoom(room3)
    moveToRoom(room2)
    moveToRoom(room1)
    moveToRoom(room)
    moveToRoom(nextroom)

    if not hit and not isDeactivated and not isChasing and nextroom and nextroom:FindFirstChild("RoomExit") then
        local tweenExit = TweenService:Create(ambush, TweenInfo.new(4, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {CFrame = nextroom.RoomExit.CFrame})
        tweenExit:Play()
        tweenExit.Completed:Wait()
    end

    -- Nếu quái chạy hết đường mà chưa kịp bắt người chơi (người chơi sống sót)
    if not isChasing then
        isDeactivated = true

        -- Kiểm tra điều kiện sống sót để cấp thành tựu 1 lần duy nhất
        if not hit and not getgenv().DeerGodBadgeGranted then
            getgenv().DeerGodBadgeGranted = true
            if deer and deer.Parent then pcall(function() deer:Destroy() end) end
            local nodeObj = Workspace:FindFirstChild("node")
            if nodeObj then nodeObj:Destroy() end
            
            local success, achievementGiver = pcall(function()
                return loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()
            end)
            if success and achievementGiver then
                pcall(function()
                    achievementGiver({
                        Title = "Last Chance To Look Away",
                        Desc = "Why are you running?",
                        Reason = "Survive the rare Entity called Deer God",
                        Image = "rbxassetid://114825307168774"
                    })
                end)
            end
        else
            if deer and deer.Parent then pcall(function() deer:Destroy() end) end
            local nodeObj = Workspace:FindFirstChild("node")
            if nodeObj then nodeObj:Destroy() end
        end
    end
end)

