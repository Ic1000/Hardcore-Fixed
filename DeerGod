-- Map Tracking Logic
local rooms = Workspace.CurrentRooms
local value = ReplicatedStorage.GameData.LatestRoom.Value

local nextroom, room, room1, room2, room3, room4, room5

local function updateRooms()
    nextroom = rooms:FindFirstChild(tostring(value + 1))
    room = rooms:FindFirstChild(tostring(value))
    room1 = rooms:FindFirstChild(tostring(value - 1))
    room2 = rooms:FindFirstChild(tostring(value - 2))
    room3 = rooms:FindFirstChild(tostring(value - 3))
    room4 = rooms:FindFirstChild(tostring(value - 4))
    room5 = rooms:FindFirstChild(tostring(value - 5))
end
updateRooms()

if ReplicatedStorage.GameData:FindFirstChild("LatestRoom") then
    ReplicatedStorage.GameData.LatestRoom.Changed:Connect(function()
        value = ReplicatedStorage.GameData.LatestRoom.Value
        updateRooms()
    end)
end

