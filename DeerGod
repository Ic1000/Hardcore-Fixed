-- Hàm tải và tạo Sound chuẩn hóa
local function GetGitSound(GithubSnd, SoundName)
    local sound = Instance.new("Sound")
    sound.Name = SoundName
    sound.Volume = 3
    sound.Looped = true
    sound.RollOffMaxDistance = 600
    sound.RollOffMinDistance = 10

    local success = pcall(function()
        if not isfile(SoundName .. ".mp3") then
            writefile(SoundName .. ".mp3", game:HttpGet(GithubSnd))
        end
        sound.SoundId = (getcustomasset or getsynasset)(SoundName .. ".mp3")
    end)

    if not success or not sound.SoundId or sound.SoundId == "" then
        sound.SoundId = "rbxassetid://9125992545" -- Dự phòng nếu executor lỗi
    end

    return sound
end

