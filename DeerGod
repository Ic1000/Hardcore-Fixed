-- Mechanism: Raycast phát hiện người chơi -> Lao tới đuổi -> Núp tủ thì dừng -> Hitbox 9 Jumpscare
task.spawn(function()
    while task.wait(0.3) do
        if hit or isDeactivated then break end
        if not entityModel or not entityModel.Parent then continue end
        if character:GetAttribute("Hiding") then continue end
        
        local primary = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart")
        if not primary then continue end

        local origin = primary.Position
        local direction = (HumanoidRootPart.Position - origin).Unit
        local ray = Ray.new(origin, direction * 60)
        local raycast = Workspace:Raycast(ray.Origin, ray.Direction)
        
        if raycast and raycast.Instance.Parent == character then
            local isChasing = true
            
            while isChasing and not hit and not isDeactivated do
                if character:GetAttribute("Hiding") then
                    isChasing = false
                    break
                end

                local hitbox = 9
                local hitOrigin = primary.Position
                local hitDirection = (HumanoidRootPart.Position - hitOrigin).Unit
                local hitRay = Ray.new(hitOrigin, hitDirection * hitbox)
                local hitResult = Workspace:Raycast(hitRay.Origin, hitRay.Direction)

                if hitResult and hitResult.Instance.Parent == character and not character:GetAttribute("Hiding") then
                    TriggerJumpscare()
                    break
                end

                if currentTween then pcall(function() currentTween:Cancel() end) end
                currentTween = TweenService:Create(primary, TweenInfo.new(2, Enum.EasingStyle.Linear), {CFrame = HumanoidRootPart.CFrame})
                currentTween:Play()
                currentTween.Completed:Wait()
            end
        end
    end
end)

-- Mechanism: Take Damage when Looking (Gây sát thương nếu nhìn trực diện)
task.spawn(function()
    while task.wait(1.5) do
        if hit or isDeactivated or getgenv().DeerGodBadgeGranted then break end
        if not entityModel or not entityModel.Parent then continue end
        if character:GetAttribute("Hiding") then continue end
        
        local primary = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart")
        if not primary then continue end

        local origin = primary.Position
        local direction = (HumanoidRootPart.Position - origin).Unit
        local ray = Ray.new(origin, direction * 5050)
        local cast = Workspace:Raycast(ray.Origin, ray.Direction)
        if cast and cast.Instance.Parent == character then
            local _, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(primary.Position)
            if onScreen and not character:GetAttribute("Hiding") then
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if humanoid then humanoid:TakeDamage(8) end
            end
        end
    end
end)

