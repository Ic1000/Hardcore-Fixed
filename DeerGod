                    local helperPart = part:FindFirstChild("RushNew") or part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
                    local deerPart = deerModel.PrimaryPart or deerModel:FindFirstChildWhichIsA("BasePart")
                    if helperPart and deerPart then
                        helperPart.CFrame = deerPart.CFrame
                    end
                    task.wait()
                end
            end)
        end)

        entity:Run()
    end
end)

-- Mechanism: Take Damage when Looking (Không gây sát thương nếu đang núp)
task.spawn(function()
    while task.wait(1.5) do
        if hit or isPlayerDead() then break end
        if isPlayerHiding(player) then continue end
        
        local origin = ambush.Position
        local direction = (HumanoidRootPart.Position - origin).Unit
        local ray = Ray.new(origin, direction * 5050)
        local cast = Workspace:Raycast(ray.Origin, ray.Direction)
        if cast and cast.Instance.Parent == character then
            local _, onScreen = Workspace.CurrentCamera:WorldToScreenPoint(ambush.Position)
            if onScreen and not isPlayerHiding(player) and not isPlayerDead() then
                player.Character.Humanoid:TakeDamage(8)
            end
        end
    end
end)

