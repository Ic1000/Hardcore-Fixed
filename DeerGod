-- Hàm hủy thực thể (Deer và Node)
local function despawnEntity()
    pcall(function() followed:Stop() end)
    pcall(function()
        if deer and deer.Parent then
            deer:Destroy()
        end
    end)
    pcall(function()
        local n = Workspace:FindFirstChild("deerlightnode")
        if n then n:Destroy() end
    end)
end

-- Spawn Spawner Node System bằng Vynixu Spawner V2
