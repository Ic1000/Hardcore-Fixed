-- ROOM OBJECT BREAK (LẦN 1 FULL ÂM THANH, LẦN 2 TRỞ ĐI RANDOM) --
--========================================================--
local function BreakRoom(room)
	if room then
		local lastBreak = destroyedRooms[room] or 0
		if tick() - lastBreak > 1.5 then
			destroyedRooms[room] = tick()
			totalRoomsBroken = totalRoomsBroken + 1
			
			task.spawn(function()
				task.wait(0.05)
				
				local breakSound = Instance.new("Sound")
				local breakSoundsList = {
					"rbxassetid://9114223171",
					"rbxassetid://9125992545", 
					"rbxassetid://4004052860",
					"rbxassetid://7142857558", 
					"rbxassetid://7142843615",
					"rbxassetid://2612674531", 
					"rbxassetid://2174790942"
				}

				-- Lần đầu tiên chạy: Full âm thanh chính cực lớn (4.5)
				-- Lần thứ hai trở đi: Random ngẫu nhiên một âm thanh trong danh sách
				if totalRoomsBroken == 1 then
					breakSound.SoundId = "rbxassetid://9114223171"
					breakSound.Volume = 4.5
				else
					breakSound.SoundId = breakSoundsList[math.random(1, #breakSoundsList)]
					breakSound.Volume = math.random(25, 35) / 10
				end

				breakSound.Parent = room:FindFirstChild("Assets") or room
				breakSound:Play()
				breakSound.Ended:Connect(function() breakSound:Destroy() end)

				local assetContainer = room:FindFirstChild("Assets") or room
				local blacklist = {"wardrobe", "bed", "rug", "key", "drawer", "book", "breaker", "table", "desk", "gold", "dresser"}

				for _, item in pairs(assetContainer:GetChildren()) do
					if item:IsA("Model") and item.Name ~= "Door" and item.Name ~= "HidingSpots" then
						local isBlacklisted = false
						local itemNameLower = string.lower(item.Name)
						for _, word in ipairs(blacklist) do
							if string.find(itemNameLower, word) then
								isBlacklisted = true
								break
							end
						end

						if not isBlacklisted then
							local soundParent = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart") or room
							if soundParent then
								local s = Instance.new("Sound")
								s.SoundId = breakSoundsList[math.random(1, #breakSoundsList)]
								s.Volume = (totalRoomsBroken == 1) and 3.5 or (math.random(20, 35) / 10)
								s.PlaybackSpeed = math.random(85, 115) / 100
								s.RollOffMaxDistance = 100
								s.Parent = soundParent
								s:Play()
								s.Ended:Connect(function() s:Destroy() end)
							end

							local primary = item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")
							if primary then
								for _, v in ipairs(item:GetDescendants()) do
									if v:IsA("BasePart") then
										local lowerName = string.lower(v.Name)
										if not string.find(lowerName, "floor") and not string.find(lowerName, "hitbox") then
											v.Anchored = false
											v.CanCollide = true
											v.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.01, 0.5, 1, 1)
											pcall(function()
												if v:GetCanSetNetworkOwnership() then
													v:SetNetworkOwner(LocalPlayer)
												end
											end)
											v.CFrame = v.CFrame + Vector3.new(0, 0.05, 0)
										end
									end
								end

								primary.Anchored = true
								task.wait()
								primary.Anchored = false

								primary.AssemblyLinearVelocity = Vector3.new(
									math.random(-60, 60),
									math.random(20, 50),
									math.random(-60, 60)
								)
								primary.AssemblyAngularVelocity = Vector3.new(
									math.random(-25, 25),
									math.random(-25, 25),
									math.random(-25, 25)
								)
							end
						end
					end
				end
			end)
		end
	end
end

local function TriggerExtremeShake()
	task.spawn(function()
		pcall(function()
			local CameraShakerModule = require(ReplicatedStorage:WaitForChild("CameraShaker", 5))
			local camera = Workspace.CurrentCamera
			if CameraShakerModule and camera then
				local despawnShake = CameraShakerModule.new(Enum.RenderPriority.Camera.Value, function(cf)
					camera.CFrame = camera.CFrame * cf
				end)
				despawnShake:Start()
				despawnShake:ShakeOnce(35, 25, 0.05, 5)
			end
		end)
	end)
end

