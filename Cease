---====== Custom Logic Variables ======---

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

LocalPlayer.CharacterAdded:Connect(function(char)
    Character = char
    Humanoid = char:WaitForChild("Humanoid")
end)

local movementConnection = nil
local lavenderColor = Color3.new(0.454902, 0.529412, 1)
local tweenInfo = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- CONFIGURABLE DETECTION FIELD
local MAX_DETECTION_DISTANCE = 75 
local VISION_ANGLE_THRESHOLD = 0.75 

-- Function to smoothly fade light colors using TweenService
local function changeLightColors()
    local currentRoom = workspace:FindFirstChild("CurrentRooms")
    if currentRoom then
        for _, room in ipairs(currentRoom:GetChildren()) do
            for _, desc in ipairs(room:GetDescendants()) do
                if desc:IsA("Light") then
                    TweenService:Create(desc, tweenInfo, {Color = lavenderColor}):Play()
                elseif desc:IsA("BasePart") and (desc.Name == "Light" or desc.Name == "Neon" or desc.Name == "Bulb") then
                    TweenService:Create(desc, tweenInfo, {Color = lavenderColor}):Play()
                end
            end
        end
    end
end

-- Integrated snippet logic: Checks direct WASD vector
local function isPlayerMoving()
    return Humanoid and Humanoid.Parent and Humanoid.MoveDirection.Magnitude > 0.1
end

-- Tắt collision và xóa bỏ hoàn toàn âm thanh Repent trong model
local function setupModelCollisionListener(model)
    if not model then return end
    
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
        elseif desc:IsA("Sound") and desc.Name == "Repent" then
            desc:Stop()
            desc:Destroy()
        end
    end
    
    model.DescendantAdded:Connect(function(desc)
        if desc:IsA("BasePart") then
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
        elseif desc:IsA("Sound") and desc.Name == "Repent" then
            desc:Stop()
            desc:Destroy()
        end
    end)
end

-- Dừng toàn bộ âm thanh thuộc về Cease khi despawn
local function stopEntitySounds(model)
    if not model then return end
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("Sound") then
            pcall(function()
                desc:Stop()
            end)
        end
    end
end

