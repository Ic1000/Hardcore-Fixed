entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
    
    local entityModel = workspace:FindFirstChild("Cease")
    if not entityModel then return end
    
    setupModelCollisionListener(entityModel)
    
    if movementConnection then
        movementConnection:Disconnect()
        movementConnection = nil
    end
    
    local originPart = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart")
    local lastPosition = originPart and originPart.Position or Vector3.new()
    
    movementConnection = RunService.Heartbeat:Connect(function()
        if not entityModel or not entityModel.Parent or not entityModel:IsDescendantOf(workspace) then
            if movementConnection then
                movementConnection:Disconnect()
                movementConnection = nil
            end
            return
        end
        
        if not Character or not Humanoid or Humanoid.Health <= 0 then return end
        
        local targetPart = Character:FindFirstChild("HumanoidRootPart")
        originPart = entityModel.PrimaryPart or entityModel:FindFirstChildWhichIsA("BasePart")
        
        if originPart and targetPart then
            local currentPosition = originPart.Position
            local toPlayerVector = (targetPart.Position - currentPosition)
            local distance = toPlayerVector.Magnitude
            
            -- Calculate head tracking heading direction based on frame displacement
            local displacement = (currentPosition - lastPosition)
            local entityMoveDirection = displacement.Magnitude > 0.01 and displacement.Unit or originPart.CFrame.LookVector
            lastPosition = currentPosition 
            
            if distance <= MAX_DETECTION_DISTANCE then
                local directionToPlayer = toPlayerVector.Unit
                local dotProduct = directionToPlayer:Dot(entityMoveDirection)
                
                if dotProduct >= VISION_ANGLE_THRESHOLD or Character:GetAttribute("Hiding") then
                    
                    -- Modern Raycast Implementation
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                    raycastParams.FilterDescendantsInstances = {entityModel, Character}
                    
                    local raycastResult = workspace:Raycast(currentPosition, toPlayerVector, raycastParams)
                    
                    if not raycastResult then
                        if isPlayerMoving() then
                            if movementConnection then
                                movementConnection:Disconnect()
                                movementConnection = nil
                            end
                            
                            -- Update backend death cause metric dynamically
                            pcall(function()
                                local playerStats = ReplicatedStorage:FindFirstChild("GameStats")
                                local targetedFolder = playerStats and playerStats:FindFirstChild("Player_" .. LocalPlayer.Name)
                                if targetedFolder and targetedFolder:FindFirstChild("Total") and targetedFolder.Total:FindFirstChild("DeathCause") then
                                    targetedFolder.Total.DeathCause.Value = "Cease"
                                end
                            end)
                            
                            Humanoid.Health = 0
                            pcall(function()
                                Spawner:Kill()
                            end)
                        end
                    end
                end
            end
        end
    end)
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    changeLightColors()
    
    local entityModel = workspace:FindFirstChild("Cease")
    if entityModel then 
        setupModelCollisionListener(entityModel) 
    end

    -- ====== CEASE FREEZE EFFECT (FULL TOÀN BỘ PART TRONG PHÒNG) ======
    task.spawn(function()
        local originalStates = {}
        local disabledInteractions = {}
        local frostColor = Color3.fromRGB(155, 215, 255)
        local meltTime = 10
        local meltTweenInfo = TweenInfo.new(meltTime, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

        -- Quét toàn bộ part không chừa món nào
        for _, desc in ipairs(room:GetDescendants()) do
            if desc:IsA("BasePart") and desc.Name ~= "Light" and desc.Name ~= "Neon" and desc.Name ~= "Bulb" then
                originalStates[desc] = {
                    Color = desc.Color,
                    Material = desc.Material
                }
                desc.Color = frostColor
                desc.Material = Enum.Material.Ice
            elseif desc:IsA("ProximityPrompt") or desc:IsA("ClickDetector") then
                if desc.Enabled == true then
                    disabledInteractions[desc] = true
                    desc.Enabled = false
                end
            end
        end

        -- Tan chảy trả màu gốc
        for part, original in pairs(originalStates) do
            if part and part.Parent then
                TweenService:Create(part, meltTweenInfo, {Color = original.Color}):Play()
            end
        end

        task.wait(meltTime)
        
        for part, original in pairs(originalStates) do
            if part and part.Parent then
                part.Material = original.Material
            end
        end

        for interaction, _ in pairs(disabledInteractions) do
            if interaction and interaction.Parent then
                interaction.Enabled = true
            end
        end
    end)
end)

entity:SetCallback("OnDespawned", function()
    if movementConnection then 
        movementConnection:Disconnect()
        movementConnection = nil
    end
    
    local entityModel = workspace:FindFirstChild("Cease")
    stopEntitySounds(entityModel)

    -- MỞ CỬA AN TOÀN KHI THỰC THỂ DESPAWN
    pcall(function()
        local currentRooms = workspace:FindFirstChild("CurrentRooms")
        local latestRoomVal = ReplicatedStorage:WaitForChild("GameData"):WaitForChild("LatestRoom").Value
        if currentRooms then
            local latestRoom = currentRooms:FindFirstChild(tostring(latestRoomVal))
            if latestRoom and latestRoom:FindFirstChild("Door") then
                local clientOpen = latestRoom.Door:FindFirstChild("ClientOpen")
                if clientOpen then
                    if clientOpen:IsA("RemoteEvent") then
                        clientOpen:FireServer()
                    elseif clientOpen:IsA("RemoteFunction") then
                        clientOpen:InvokeServer()
                    end
                end
            end
        end
    end)
end)

