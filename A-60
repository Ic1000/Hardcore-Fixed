local function GiveA60Achievement()
	if getgenv().A60AchievementGotten then return end
	
	-- Kiểm tra an toàn xem người chơi có còn sống không trước khi trao thành tựu sống sót
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum and hum.Health <= 0 then 
		return -- Nếu chết rồi thì không cho thành tựu sống sót
	end
	
	getgenv().A60AchievementGotten = true

	task.spawn(function()
		local success, achievementGiver = pcall(function()
			return loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Custom%20Achievements/Source.lua"))()
		end)
		if success and achievementGiver then
			pcall(function()
				achievementGiver({
					Title = "A nostalgic fright...",
					Desc = "Might Come back...",
					Reason = "Encounter and survive the rare Entity called A-60",
					Image = "rbxassetid://17857830685"
				})
			end)
		end
	end)
end

-- Hàm tải âm thanh Git an toàn tuyệt đối, chống lỗi nil value
local function GetGitSound(GithubSnd, SoundName)
	local sound = Instance.new("Sound")
	local success = pcall(function()
		if writefile and isfile and (getcustomasset or getsynasset) then
			if not isfile(SoundName .. ".mp3") then
				writefile(SoundName .. ".mp3", game:HttpGet(GithubSnd))
			end
			local getAsset = getcustomasset or getsynasset
			sound.SoundId = getAsset(SoundName .. ".mp3")
		else
			error("Custom assets not supported")
		end
	end)
	
	if not success or sound.SoundId == "" or sound.SoundId == nil then
		sound.SoundId = "rbxassetid://9114223173" -- Fallback an toàn
	end
	return sound
end

