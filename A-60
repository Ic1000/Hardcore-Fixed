entity:SetCallback("OnDespawned", function()
	print("A-60 has despawned")

	local despawnSound = Instance.new("Sound")
	despawnSound.SoundId = "rbxassetid://7757472223"
	despawnSound.Volume = 10
	despawnSound.PlaybackSpeed = 0.1
	despawnSound.Parent = Workspace
	despawnSound:Play()
	Debris:AddItem(despawnSound, 25)

	task.spawn(function()
		while despawnSound.IsPlaying do
			task.wait(0.5)
			if LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
				if LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health == 0 then
					despawnSound:Destroy()
					break
				end
			end
		end
	end)

	local despawnColor = Instance.new("ColorCorrectionEffect", Lighting)
	despawnColor.Name = "A60_DespawnEffect"
	despawnColor.TintColor = Color3.fromRGB(255, 0, 4)
	despawnColor.Saturation = -0.7
	despawnColor.Contrast = 0.2
	Debris:AddItem(despawnColor, 40)

	TweenService:Create(despawnColor, TweenInfo.new(15), {
		TintColor = Color3.fromRGB(255, 255, 255),
		Saturation = 0,
		Contrast = 0
	}):Play()
	TweenService:Create(despawnSound, TweenInfo.new(23), { Volume = 0 }):Play()

	local cameraShakerModule = require(ReplicatedStorage:WaitForChild("CameraShaker"))
	local shaker = cameraShakerModule.new(Enum.RenderPriority.Camera.Value, function(cf)
		CurrentCamera.CFrame = CurrentCamera.CFrame * cf
	end)
	shaker:Start()
	shaker:ShakeOnce(5, 45, 0.1, 20)

	-- GỌI HÀM NHẬN THÀNH TỰU AN TOÀN KHI A-60 BIẾN MẤT (SỐNG SÓT)
	GiveA60Achievement()
end)

