-- Hàm Thực Hiện Jumpscare A-60 khi chạm người chơi
local function TriggerJumpscare()
	print("Executing A-60 Native Jumpscare...")
	
	local jumpscareGui = Instance.new("ScreenGui")
	jumpscareGui.Name = "A60_JumpscareGui"
	jumpscareGui.Parent = PlayerGui
	jumpscareGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local jumpscareEndImg = Instance.new("ImageLabel")
	jumpscareEndImg.Name = "JumpscareEnd"
	jumpscareEndImg.Parent = jumpscareGui
	jumpscareEndImg.BackgroundTransparency = 1
	jumpscareEndImg.Position = UDim2.new(0.468, 0, 0.455, 0)
	jumpscareEndImg.Size = UDim2.new(0.063, 0, 0.088, 0)
	jumpscareEndImg.ImageColor3 = Color3.fromRGB(255, 0, 4)

	local fullImg = Instance.new("ImageLabel")
	fullImg.Name = "Full"
	fullImg.Parent = jumpscareGui
	fullImg.BackgroundTransparency = 1
	fullImg.Position = UDim2.new(-0.06, 0, -0.224, 0)
	fullImg.Size = UDim2.new(1.121, 0, 1.447, 0)
	fullImg.Image = "http://www.roblox.com/asset/?id=11151804223"
	fullImg.ImageTransparency = 1

	task.spawn(function()
		local a60Model = Workspace:FindFirstChild("A-60")
		if not a60Model then return end

		local cameraShakerModule = require(ReplicatedStorage:WaitForChild("CameraShaker"))
		local shaker = cameraShakerModule.new(Enum.RenderPriority.Camera.Value, function(cf)
			CurrentCamera.CFrame = CurrentCamera.CFrame * cf
		end)
		shaker:Start()

		local isScaring = true
		local rushNew = a60Model:FindFirstChild("RushNew")
		if not rushNew then return end

		local scareClone = rushNew:Clone()
		scareClone.Name = "A-60_SCARE"
		scareClone.Parent = CurrentCamera

		task.spawn(function()
			while isScaring and scareClone and scareClone.Parent do
				local imageFolder = scareClone:FindFirstChild("IMAGEIDS")
				local face = scareClone:FindFirstChild("Main") and scareClone.Main:FindFirstChild("Face")
				if face then
					if imageFolder and #imageFolder:GetChildren() > 0 then
						local randomImg = imageFolder:GetChildren()[math.random(1, #imageFolder:GetChildren())]
						face.Texture = randomImg.Image
					else
						face.Texture = "rbxassetid://11394048190"
					end
				end
				task.wait(Random.new():NextNumber(0, 0.02))
			end
		end)

		for _, sound in ipairs(scareClone:GetDescendants()) do
			if sound:IsA("Sound") then sound:Destroy() end
		end

		local scareSoundClone = scareAudio:Clone()
		scareSoundClone.Parent = Workspace
		scareSoundClone.Volume = 6
		scareSoundClone:Play()

		shaker:ShakeOnce(25, 25, 0, 4, 90, 60)

		local colorCorrection = Instance.new("ColorCorrectionEffect", Lighting)
		TweenService:Create(colorCorrection, TweenInfo.new(0.5), {
			Brightness = 0.2,
			Contrast = 0.2,
			Saturation = -0.2,
			TintColor = Color3.fromRGB(255, 0, 4),
		}):Play()

		local followConnection
		followConnection = RunService.RenderStepped:Connect(function()
			if isScaring and scareClone and scareClone.Parent then
				scareClone.CFrame = scareClone.CFrame:Lerp(CurrentCamera.CFrame * CFrame.new(Vector3.new(0, -1.2, -5)), 0.8)
			else
				if followConnection then followConnection:Disconnect() end
			end
		end)

		task.wait(0.5)
		isScaring = false

		local mainFace = scareClone:FindFirstChild("Main") and scareClone.Main:FindFirstChild("Face")
		if mainFace then
			jumpscareEndImg.Image = mainFace.Texture
		end

		TweenService:Create(jumpscareEndImg, TweenInfo.new(0.5), {
			Size = fullImg.Size,
			Position = fullImg.Position,
			Rotation = math.random(-20, 20),
		}):Play()

		TweenService:Create(colorCorrection, TweenInfo.new(10), {
			Brightness = 0,
			Contrast = 0,
			Saturation = 0,
			TintColor = Color3.fromRGB(255, 255, 255),
		}):Play()

		task.wait(0.5)
		TweenService:Create(jumpscareEndImg, TweenInfo.new(0.5), { ImageTransparency = 1 }):Play()
		Debris:AddItem(scareClone, 1)
		Debris:AddItem(scareSoundClone, 3)
		Debris:AddItem(colorCorrection, 3)
		Debris:AddItem(jumpscareGui, 3)
	end)
end

---====== Debug entity Callbacks ======---

entity:SetCallback("OnSpawned", function()
	print("A-60 has spawned")
	
	task.spawn(function()
		local a60Model = Workspace:WaitForChild("A-60", 5)
		if not a60Model then return end
		local rushNewPart = a60Model:WaitForChild("RushNew", 5)
		if not rushNewPart then return end

		local staticSound = rushNewPart:FindFirstChild("Static")
		if staticSound then
			staticSound:Play()
			staticSound.PlaybackSpeed = 1.6
		end

		while entity:IsAlive() and RunService.Heartbeat:Wait() do
			local imageFolder = rushNewPart:FindFirstChild("IMAGEIDS")
			local face = rushNewPart:FindFirstChild("Main") and rushNewPart.Main:FindFirstChild("Face")
			if face and imageFolder then
				local images = imageFolder:GetChildren()
				if #images > 0 then
					face.Texture = images[math.random(1, #images)].Image
				end
			end
			task.wait(Random.new():NextNumber(0, 0.03))
		end
	end)
end)

